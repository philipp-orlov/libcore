# One spelling of the sanitizer switch for every component:
#   -DCORE_SANITIZE=address,undefined   (or: thread)
include_guard(GLOBAL)
set(CORE_SANITIZE "" CACHE STRING "Sanitizers to build with (the value of -fsanitize=), empty for none")
if(CORE_SANITIZE)
    if(CORE_SANITIZE MATCHES "thread" AND CORE_SANITIZE MATCHES "address")
        message(FATAL_ERROR "CORE_SANITIZE: address and thread cannot be combined")
    endif()
    add_compile_options(-fsanitize=${CORE_SANITIZE} -fno-omit-frame-pointer -g)
    add_link_options(-fsanitize=${CORE_SANITIZE})
    if(CORE_SANITIZE MATCHES "undefined")
        add_compile_options(-fno-sanitize-recover=undefined)
    endif()
endif()
