# One spelling of the sanitizer switch for every component:
#   -DDEVELOP_SANITIZE=address,undefined   (or: thread)
include_guard(GLOBAL)
set(DEVELOP_SANITIZE "" CACHE STRING "Sanitizers to build with (the value of -fsanitize=), empty for none")
if(DEVELOP_SANITIZE)
    if(DEVELOP_SANITIZE MATCHES "thread" AND DEVELOP_SANITIZE MATCHES "address")
        message(FATAL_ERROR "DEVELOP_SANITIZE: address and thread cannot be combined")
    endif()
    add_compile_options(-fsanitize=${DEVELOP_SANITIZE} -fno-omit-frame-pointer -g)
    add_link_options(-fsanitize=${DEVELOP_SANITIZE})
    if(DEVELOP_SANITIZE MATCHES "undefined")
        add_compile_options(-fno-sanitize-recover=undefined)
    endif()
endif()
